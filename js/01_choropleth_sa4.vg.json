{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "title": {
        "text": "Where is work hardest to find?",
        "subtitle": "Unemployment rate by region (SA4), July of each year",
        "anchor": "start",
        "fontSize": 20,
        "subtitleFontSize": 13
    },
    "width": 640,
    "height": 460,
    "params": [
        {
            "name": "year",
            "value": 2026,
            "bind": {
                "input": "radio",
                "options": [2016, 2021, 2026],
                "name": "Year: "
            }
        }
    ],
    "projection": {
        "type": "conicEqualArea",
        "rotate": [-134, 0, 0],
        "parallels": [-18, -36]
    },
    "layer": [
        {
            "description": "Grey base layer so regions without data still show their outline",
            "data": {
                "url": "https://raw.githubusercontent.com/hraj0016/fit3179-dv2-hrishita/main/data/sa4_boundaries.json",
                "format": {"type": "topojson", "feature": "ABS_SA4_2011"}
            },
            "mark": {"type": "geoshape", "fill": "#e9e9e9", "stroke": "#ffffff", "strokeWidth": 0.3}
        },
        {
            "description": "Unemployment rate joined onto SA4 shapes by SA4 code",
            "data": {
                "url": "https://raw.githubusercontent.com/hraj0016/fit3179-dv2-hrishita/main/data/sa4_timeseries.csv",
                "format": {
                    "type": "csv",
                    "parse" : {"sa4_code": "string", "year": "number", "unemployment_rate": "number"}
                }
            },
            "transform": [
                {"filter": "datum.year == year"},
                {
                    "lookup": "sa4_code",
                    "from": {
                        "data": {
                            "url" : "https://raw.githubusercontent.com/hraj0016/fit3179-dv2-hrishita/main/data/sa4_boundaries.json",
                            "format": {"type": "topojson", "feature": "ABS_SA4_2011"}
                        },
                        "key": "properties.SA4_CODE11"
                    },
                    "as": "geo"
                }, 
                {
                    "calculate": "datum.unemployment_rate < 3 ? 'Under 3%' : datum.unemployment_rate < 4 ? '3–4%' : datum.unemployment_rate < 5 ? '4–5%' : datum.unemployment_rate < 6 ? '5–6%' : datum.unemployment_rate < 7 ? '6–7%' : '7% or more'",
                    "as": "rate_band"
                }
            ],
            "mark": {"type": "geoshape", "stroke": "#ffffff", "strokeWidth": 0.3},
            "encoding": {
                "shape": {"field": "geo", "type": "geojson"},
                "color": {
                    "field": "rate_band",
                    "type": "ordinal",
                    "title": "Unemployment rate (%)",
                    "scale": {
                        "domain": ["Under 3%", "3–4%", "4–5%", "5–6%", "6–7%", "7% or more"],
                        "range": ["#ffffb2", "3fed976", "#feb24c", "#fd8d3c", "#f03b20", "#bd0026"]
                    },
                    "legend": {
                        "orient": "bottom-left",
                        "direction": "horizontal",
                        "symbolType": "square",
                        "symbolSize": 200,
                        "labelFontSize": 12,
                        "titleFontSize": 12,
                        "columns": 
                    }
                },
                "tooltip": [
                    {"field": "sa4_name", "title": "Region"},
                    {"field": "state", "title": "State"},
                    {"field": "unemployment_rate", "title": "Unemployment rate (%)", "format": ".1f"},
                    {"field": "unemployed_000", "title": "People unemployed ('000)", "format": ".1f"}
                ]
            }
        },
        {
            "description": "White outline behind labels so they stay readable on dark colours",
            "data": {
                "values": [
                    {"label": "WA", "lon": 123, "lat": -26},
                    {"label": "NT", "lon": 133.5, "lat": -19.5},
                    {"label": "SA", "lon": 135, "lat": -30},
                    {"label": "QLD", "lon": 144, "lat": -23},
                    {"label": "NSW", "lon": 146.5, "lat": -32},
                    {"label": "VIC", "lon": 144, "lat": -37.2},
                    {"label": "TAS", "lon": 146.6, "lat": -42.2}
                ]
            },
            "mark": {
                "type": "text",
                "fontSize": 13,
                "fontWeight": "bold",
                "color": "#ffffff",
                "stroke": "#ffffff",
                "strokeWidth": 3.5,
                "opacity": 0.9
            },
            "encoding": {
                "longitude": {"field": "lon", "type": "quantitative"},
                "latitude": {"field": "lat", "type": "quantitative"},
                "text": {"field": "label"}
            }
        },
        {
            "description": "State labels so readers can orient themselves",
            "data": {
                "values": [
                    {"label": "WA", "lon": 123, "lat": -26},
                    {"label": "NT", "lon": 133.5, "lat": -19.5},
                    {"label": "SA", "lon": 135, "lat": -30},
                    {"label": "QLD", "lon": 144, "lat": -23},
                    {"label": "NSW", "lon": 146.5, "lat": -32},
                    {"label": "VIC", "lon": 144, "lat": -37.2},
                    {"label": "TAS", "lon": 146.6, "lat": -42.2}
                ]
            },
            "mark": {
                "type": "text",
                "fontSize": 13,
                "fontWeight": "bold",
                "color": "#222222"
            },
            "encoding": {
                "longitude": {"field": "lon", "type": "quantitative"},
                "latitude": {"field": "lat", "type": "quantitative"},
                "text": {"field": "label"}
            }
        }
    ],
    "config": {"view": {"stroke": null}}
}